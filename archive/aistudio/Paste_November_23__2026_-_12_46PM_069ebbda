function renderStory(c){
 $('story').setAttribute('aria-label',c.storyAria);
 $('story').innerHTML=c.chapters.map((chapter,i)=>`<article class="chapter reveal" data-scene="${i}" id="chapter-${i+1}"><div class="chapter-copy"><div class="chapter-index"><b>${String(i+1).padStart(2,'0')}</b><span>${esc(chapter.label)}</span></div><h2>${chapter.title}</h2>${chapter.body.map(p=>`<p>${esc(p)}</p>`).join('')}<p class="chapter-epigraph">${esc(chapter.epigraph)}</p></div><div class="chapter-visual">${visualFor(i,c)}</div></article>`).join('');
 document.querySelectorAll('[data-image]').forEach(img=>{const key=img.getAttribute('data-image');if(IMAGE_DATA[key])img.src=IMAGE_DATA[key]});
 document.querySelectorAll('.chapter.reveal').forEach(el=>revealObserver?.observe(el));
 updateGemUI(c);
}
