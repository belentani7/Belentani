function updateGemUI(c=I18N[currentLang]){
 const n=activeGems.size;const counter=$('facetCount');if(counter)counter.textContent=`${n} / 5`;
 const hint=$('facetHint');if(hint)hint.textContent=n===5?c.mapReady:c.tap;
