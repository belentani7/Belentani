 const set=(id,val)=>{if($(id))$(id).textContent=val};
 set('brandSub',c.brandSub);set('skipLink',c.skip);set('heroKicker',c.heroKicker);set('titleA',c.titleA);set('titleB',c.titleB);set('heroDeck',c.heroDeck);set('heroFootnote',c.heroFootnote);set('enterButton',c.enter);set('scrollCue',c.scroll);set('portraitCaption',c.portraitCaption);set('northLabel',c.northLabel);set('fictionStamp',c.fictionStamp);$('northQuote').innerHTML=c.northQuote;set('northText',c.northText);set('archiveKicker',c.archiveKicker);set('archiveHeading',c.archiveHeading);set('archiveText',c.archiveText);set('observatoryKicker',c.observatoryKicker);set('observatoryHeading',c.observatoryHeading);set('observatoryText',c.observatoryText);set('nasaCredit',c.nasaCredit);set('modelLink',c.modelLink);set('nasaSourceLink',c.nasaSourceLink);set('soundKicker',c.soundKicker);set('soundHeading',c.soundHeading);set('soundText',c.soundText);set('soundFootnote',c.soundFootnote);set('soundModeLabel',c.soundMode);set('fileButtonText',c.fileText);set('soundIdle',c.soundIdle);set('filePrivacy',c.filePrivacy);set('finalKicker',c.finalKicker);set('finalHeading',c.finalHeading);set('finalText',c.finalText);set('finalQuote',c.finalQuote);set('fictionNote',c.fictionNote);set('footerNote',c.footerNote);set('artistLink',c.footerLink);set('downloadMap',c.mapButton+' ↓');$('soundButton').setAttribute('aria-label',c.ariaSound);$('localAudio').setAttribute('aria-label',c.ariaFile);
 renderStory(c);document.querySelectorAll('[data-image]').forEach((img)=>{const key=img.getAttribute('data-image');if(IMAGE_DATA[key]){img.src=IMAGE_DATA[key];const index={gaze:0,venom:1,system:3,zion:4,orion:5}[key];if(index!==undefined)img.alt=c.alts[index]}});
 setAudioStatus();updateGemUI(c);
}
let revealObserver=null;
