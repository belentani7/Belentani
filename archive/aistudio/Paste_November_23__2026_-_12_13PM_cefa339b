        "DISCOGRAFÍA ACTIVA [2026]:\n" +
          "  01. Judas (prod. Hey Duck)\n" +
          "  02. Cassandra (Molhou meus olhos)\n" +
          "  03. Nemo Throat Stone\n" +
          "  04. Shark Eyes\n" +
          "  05. Apaga a Luz"
      );
      return;
    }

    if (cmd === "nodes") {
      streamResponse(
        "GALAXIA VIAJE3D: 44/44 planetas sincronizados con github.com/belentani7."
      );
      return;
    }

    if (cmd === "clear") {
      setLogs([]);
      return;
    }

    streamResponse(
      `Comando no reconocido: '${cmd}'. Ejecuta 'help' para listar instrucciones.`
    );
  };

  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === "Enter") {
      executeCommand(input);
      setInput("");
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (historyIdx + 1 < history.length) {
        const next = historyIdx + 1;
        setHistoryIdx(next);
        setInput(history[next]);
      }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (historyIdx > 0) {
        const prev = historyIdx - 1;
        setHistoryIdx(prev);
        setInput(history[prev]);
      } else {
        setHistoryIdx(-1);
        setInput("");
      }
    }
  };

  return (
    <div className="judas-milky-glass w-full max-w-3xl p-5 font-mono text-sm text-zinc-100">
      {/* Barra superior del terminal */}
      <div className="mb-3 flex items-center justify-between border-b border-red-500/30 pb-2 text-xs text-red-400">
        <span>CHAR+ // TERMINAL DE ACCESO DIRECTO</span>
        <span className="text-amber-300/80">
          {isStreaming ? "STREAMING..." : "READY"}
        </span>
      </div>

      {/* Área de salida */}
      <div className="h-64 space-y-2 overflow-y-auto pr-2 leading-relaxed">
        {logs.map((log) => (
          <div
            key={log.id}
            className={
              log.type === "input"
                ? "text-amber-300"
                : log.type === "system"
                ? "text-red-400/90"
                : "whitespace-pre-wrap text-zinc-200"
            }
          >
            {log.text}
          </div>
        ))}
        <div ref={bottomRef} />
      </div>

      {/* Prompt de entrada */}
      <div className="mt-3 flex items-center gap-2 border-t border-red-500/30 pt-3">
        <span className="font-bold text-red-500">belentani@judas:~$</span>
        <input
          type="text"
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={handleKeyDown}
          disabled={isStreaming}
          placeholder="char+ judas"
          className="w-full bg-transparent text-zinc-100 placeholder-zinc-600 focus:outline-none"
          autoComplete="off"
          spellCheck={false}
        />
      </div>
    </div>
  );
}
