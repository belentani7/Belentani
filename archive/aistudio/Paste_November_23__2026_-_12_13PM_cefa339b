        time: 0,
        speed: 1.0,
        morph: 1.35,
        goldMix: 0.48,
        shatterAmount: 0.25,
        shatteredMode: false,
        chroma: 0.35,
        mouse: new THREE.Vector2(0, 0),
        targetCamPos: new THREE.Vector3(0, 3.2, 13.5),
        targetLookAt: new THREE.Vector3(0, 0, 0),
        selectedNodeIndex: 0,
        audioActive: false,
        bass: 0,
        mid: 0,
        high: 0,
        currentTrackIndex: 0
      };

      /* ======================================================================
         C. INICIALIZACIÓN DE ESCENA THREE.JS & SHADERS
         ====================================================================== */
      const canvas = document.getElementById("webgl-stage");
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        powerPreference: "high-performance"
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.25;

      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x050002, 0.016);

      const camera = new THREE.PerspectiveCamera(52, window.innerWidth / window.innerHeight, 0.1, 250);
      camera.position.copy(state.targetCamPos);

      // Iluminación dramática carmesí y oro
      const ambientLight = new THREE.AmbientLight(0x28040c, 1.4);
      scene.add(ambientLight);

      const crimsonLight = new THREE.PointLight(0xff002b, 5.5, 45);
      crimsonLight.position.set(6, 5, 8);
      scene.add(crimsonLight);

      const goldLight = new THREE.PointLight(0xe6b84c, 4.2, 45);
      goldLight.position.set(-7, -4, 6);
      scene.add(goldLight);

      const rimLight = new THREE.DirectionalLight(0xffccd5, 1.6);
      rimLight.position.set(0, 12, -10);
      scene.add(rimLight);

      // 1. Skybox Nebula Shader
      const skyGeo = new THREE.SphereGeometry(110, 32, 32);
      const skyMat = new THREE.ShaderMaterial({
        vertexShader: document.getElementById("nebulaVert").textContent,
        fragmentShader: document.getElementById("nebulaFrag").textContent,
        side: THREE.BackSide,
        depthWrite: false,
        uniforms: {
          uTime: { value: 0 },
          uChroma: { value: state.chroma }
        }
      });
      const skyMesh = new THREE.Mesh(skyGeo, skyMat);
      scene.add(skyMesh);

      // 2. Núcleo Central de Vidrio Líquido Carmesí & Oro ("El Corazón de Judas")
      const coreGeo = new THREE.IcosahedronGeometry(2.35, 64);
      const coreUniforms = {
        uTime: { value: 0 },
        uMorph: { value: state.morph },
        uGoldMix: { value: state.goldMix },
        uBass: { value: 0 },
        uMid: { value: 0 },
        uHigh: { value: 0 },
        uCameraPos: { value: camera.position }
      };
      const coreMat = new THREE.ShaderMaterial({
        vertexShader: document.getElementById("liquidCoreVert").textContent,
        fragmentShader: document.getElementById("liquidCoreFrag").textContent,
        transparent: true,
        uniforms: coreUniforms
      });
      const coreMesh = new THREE.Mesh(coreGeo, coreMat);
      scene.add(coreMesh);

      // 3. Anillos Alquímicos de Oro Líquido
      const ringsGroup = new THREE.Group();
      const ringMat = new THREE.MeshStandardMaterial({
        color: 0xe6b84c,
        emissive: 0x4a2c00,
        metalness: 0.95,
        roughness: 0.14
      });

      const ring1 = new THREE.Mesh(new THREE.TorusGeometry(3.45, 0.045, 24, 160), ringMat);
      ring1.rotation.x = Math.PI * 0.38;
      ringsGroup.add(ring1);

      const ring2 = new THREE.Mesh(new THREE.TorusGeometry(4.15, 0.028, 20, 160), ringMat);
      ring2.rotation.y = Math.PI * 0.28;
      ring2.rotation.x = -Math.PI * 0.22;
      ringsGroup.add(ring2);

      scene.add(ringsGroup);

      // 4. Constelación de 180 Espejos Fracturados (InstancedMesh)
      const SHARD_COUNT = 180;
      const shardGeo = new THREE.OctahedronGeometry(0.26, 0);
      shardGeo.scale(1.4, 2.2, 0.14); // Forma de esquirla plana de espejo
      const shardMat = new THREE.MeshPhysicalMaterial({
        color: 0xffd6de,
        emissive: 0x2a0008,
        metalness: 0.92,
        roughness: 0.08,
        reflectivity: 1.0,
        clearcoat: 1.0
      });
      const shardInstanced = new THREE.InstancedMesh(shardGeo, shardMat, SHARD_COUNT);
      const shardData = [];
      const dummy = new THREE.Object3D();

      for (let i = 0; i < SHARD_COUNT; i++) {
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        const baseRadius = 3.2 + Math.random() * 3.8;
        shardData.push({
          theta,
          phi,
          baseRadius,
          rotSpeed: new THREE.Vector3(
            (Math.random() - 0.5) * 2.2,
            (Math.random() - 0.5) * 2.2,
            (Math.random() - 0.5) * 2.2
          ),
          phase: Math.random() * Math.PI * 2,
          scale: 0.45 + Math.random() * 1.15
        });
      }
      scene.add(shardInstanced);

      // 5. Galaxia Espiral VIAJE-3D (44 Planetas Interactivos)
      const galaxyGroup = new THREE.Group();
      const planetMeshes = [];
      const goldenAngle = Math.PI * (3 - Math.sqrt(5)); // Ángulo áureo

      // Línea orbital espiral conectora
      const spiralPoints = [];

      GALAXY_NODES.forEach((node, idx) => {
        const t = idx / (GALAXY_NODES.length - 1);
        const radius = 5.4 + t * 14.5;
        const angle = idx * goldenAngle * 1.65;
        const yOffset = Math.sin(idx * 0.65) * 1.85;

        const x = Math.cos(angle) * radius;
        const z = Math.sin(angle) * radius;
        spiralPoints.push(new THREE.Vector3(x, yOffset, z));

        const isGold = idx % 4 === 0;
        const pGeo = new THREE.SphereGeometry(0.28 + (idx === 0 ? 0.18 : 0), 28, 28);
        const pMat = new THREE.MeshStandardMaterial({
          color: isGold ? 0xe6b84c : 0xff002b,
          emissive: isGold ? 0x6e4700 : 0x7a0014,
          emissiveIntensity: 0.85,
          metalness: 0.75,
          roughness: 0.2
        });

        const pMesh = new THREE.Mesh(pGeo, pMat);
        pMesh.position.set(x, yOffset, z);
        pMesh.userData = { index: idx, node, basePos: new THREE.Vector3(x, yOffset, z) };

        // Halo sutil alrededor de cada planeta
        const halo = new THREE.Mesh(
          new THREE.RingGeometry(0.38, 0.46, 32),
          new THREE.MeshBasicMaterial({
            color: isGold ? 0xffe18c : 0xff3355,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0.55
          })
        );
        halo.rotation.x = Math.PI / 2;
        pMesh.add(halo);

        galaxyGroup.add(pMesh);
        planetMeshes.push(pMesh);
      });

      const spiralCurve = new THREE.CatmullRomCurve3(spiralPoints);
      const spiralGeo = new THREE.BufferGeometry().setFromPoints(spiralCurve.getPoints(320));
      const spiralLine = new THREE.Line(
        spiralGeo,
        new THREE.LineBasicMaterial({ color: 0xff002b, transparent: true, opacity: 0.28 })
      );
      galaxyGroup.add(spiralLine);
      scene.add(galaxyGroup);

      // 6. Campo de 3,500 Partículas de Ceniza Carmesí y Polvo de Oro
      const PARTICLE_COUNT = 3500;
      const pPositions = new Float32Array(PARTICLE_COUNT * 3);
      const pColors = new Float32Array(PARTICLE_COUNT * 3);

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const r = 3 + Math.random() * 34;
        const a = Math.random() * Math.PI * 2;
        const y = (Math.random() - 0.5) * 18;
        pPositions[i * 3] = Math.cos(a) * r;
        pPositions[i * 3 + 1] = y;
        pPositions[i * 3 + 2] = Math.sin(a) * r;

        const gold = Math.random() > 0.72;
        pColors[i * 3] = gold ? 0.92 : 1.0;
        pColors[i * 3 + 1] = gold ? 0.72 : 0.04;
        pColors[i * 3 + 2] = gold ? 0.28 : 0.18;
      }

      const particlesGeo = new THREE.BufferGeometry();
      particlesGeo.setAttribute("position", new THREE.BufferAttribute(pPositions, 3));
      particlesGeo.setAttribute("color", new THREE.BufferAttribute(pColors, 3));

      const particlesMat = new THREE.PointsMaterial({
        size: 0.085,
        vertexColors: true,
        transparent: true,
        opacity: 0.78,
        blending: THREE.AdditiveBlending
      });
      const particleSystem = new THREE.Points(particlesGeo, particlesMat);
      scene.add(particleSystem);

      /* ======================================================================
         D. MOTOR WEB AUDIO API (SINTETIZADOR 432 HZ + ANALIZADOR FFT + DROPZONE)
         ====================================================================== */
      let audioCtx = null;
      let analyser = null;
      let freqData = null;
      let droneOsc1 = null;
      let droneOsc2 = null;
      let subOsc = null;
      let droneGain = null;
      let externalAudioEl = null;
      let externalSource = null;

      function initAudioEngine() {
        if (audioCtx) return;
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();

        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;
        freqData = new Uint8Array(analyser.frequencyBinCount);

        droneGain = audioCtx.createGain();
        droneGain.gain.value = 0.0;

        // Filtro paso-bajo cálido analógico
        const filter = audioCtx.createBiquadFilter();
        filter.type = "lowpass";
        filter.frequency.value = 420;
        filter.Q.value = 3.5;

        // Osciladores armónicos centrados en 432 Hz (108 Hz fundamental + 216 Hz octava + 162 Hz quinta)
        droneOsc1 = audioCtx.createOscillator();
        droneOsc1.type = "sawtooth";
        droneOsc1.frequency.value = 108; // 432 / 4

        droneOsc2 = audioCtx.createOscillator();
        droneOsc2.type = "triangle";
        droneOsc2.frequency.value = 162; // Quinta justa sobre 108 Hz

        subOsc = audioCtx.createOscillator();
        subOsc.type = "sine";
        subOsc.frequency.value = 54; // Sub-grave 432 / 8

        droneOsc1.connect(filter);
        droneOsc2.connect(filter);
        subOsc.connect(filter);
        filter.connect(droneGain);
        droneGain.connect(analyser);
        analyser.connect(audioCtx.destination);

        droneOsc1.start();
        droneOsc2.start();
        subOsc.start();
      }

      function toggleDrone(forceState) {
        initAudioEngine();
        if (audioCtx.state === "suspended") audioCtx.resume();

        state.audioActive = typeof forceState === "boolean" ? forceState : !state.audioActive;
        const btn = document.getElementById("btn-audio-toggle");

        if (state.audioActive) {
          droneGain.gain.setTargetAtTime(0.18, audioCtx.currentTime, 0.35);
          btn.textContent = "SILENCIAR 432 HZ";
          btn.classList.add("active");
        } else {
          droneGain.gain.setTargetAtTime(0.0, audioCtx.currentTime, 0.25);
          if (externalAudioEl) externalAudioEl.pause();
          btn.textContent = "ACTIVAR DRONE";
          btn.classList.remove("active");
        }
      }

      function playHarmonicPulse(freq = 216) {
        if (!audioCtx) return;
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(freq, now);
        osc.frequency.exponentialRampToValueAtTime(freq * 1.5, now + 0.35);
        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.45);
        osc.connect(gain);
        gain.connect(analyser);
        osc.start(now);
        osc.stop(now + 0.46);
      }

      function tuneDroneToTrack(track, idx) {
        state.currentTrackIndex = idx;
        renderTrackList();
        if (!state.audioActive) toggleDrone(true);
        if (audioCtx && droneOsc1 && droneOsc2 && subOsc) {
          const base = track.freq || 108;
          droneOsc1.frequency.setTargetAtTime(base, audioCtx.currentTime, 0.3);
          droneOsc2.frequency.setTargetAtTime(base * 1.5, audioCtx.currentTime, 0.3);
          subOsc.frequency.setTargetAtTime(base * 0.5, audioCtx.currentTime, 0.3);
          playHarmonicPulse(base * 2);
        }
      }

      function loadExternalAudioFile(file) {
        if (!file) return;
        initAudioEngine();
        if (audioCtx.state === "suspended") audioCtx.resume();
        if (droneGain) droneGain.gain.setTargetAtTime(0.0, audioCtx.currentTime, 0.15);

        if (externalAudioEl) {
          externalAudioEl.pause();
          externalAudioEl.remove();
        }
        externalAudioEl = new Audio();
        externalAudioEl.src = URL.createObjectURL(file);
        externalAudioEl.crossOrigin = "anonymous";
        externalAudioEl.loop = true;

        externalSource = audioCtx.createMediaElementSource(externalAudioEl);
        externalSource.connect(analyser);
        externalAudioEl.play();
        state.audioActive = true;
        document.getElementById("btn-audio-toggle").textContent = "SONANDO MASTER";
        document.getElementById("audio-dropzone").textContent = "Master activo: " + file.name;
      }

      /* ======================================================================
         E. RENDERIZADO DE UI (TRACKS, CÓDICE, INSPECTOR Y CONTROLES)
         ====================================================================== */
      function renderTrackList() {
        const container = document.getElementById("track-list");
        container.innerHTML = "";
        DISCOGRAPHY.forEach((tr, i) => {
          const el = document.createElement("div");
          el.className = "track-item" + (i === state.currentTrackIndex ? " playing" : "");
          el.innerHTML = `
            <div>
              <div class="track-name">${String(i + 1).padStart(2, "0")}. ${tr.title}</div>
              <div class="track-meta">${tr.genre} · ${tr.prod}</div>
            </div>
            <div class="panel-badge">${tr.freq} Hz</div>
          `;
          el.addEventListener("click", () => tuneDroneToTrack(tr, i));
          container.appendChild(el);
        });
      }

      function renderCodex() {
        const body = document.getElementById("codex-body");
        body.innerHTML = "";

        LORE_CHAPTERS.forEach((ch) => {
          const card = document.createElement("article");
          card.className = "lore-card";
          card.innerHTML = `<h3>${ch.title}</h3><p>${ch.body}</p>`;
          body.appendChild(card);
        });

        DISCOGRAPHY.forEach((tr) => {
          const card = document.createElement("article");
          card.className = "lore-card";
          card.style.borderColor = "var(--border-gold)";
          card.innerHTML = `
            <h3>TRACK // ${tr.title} (${tr.year})</h3>
            <p><strong>Producción:</strong> ${tr.prod} · <strong>Género:</strong> ${tr.genre} · <strong>Base:</strong> ${tr.freq} Hz</p>
            <p>${tr.lore}</p>
          `;
          body.appendChild(card);
        });
      }

      function selectGalaxyNode(idx) {
        const clamped = ((idx % GALAXY_NODES.length) + GALAXY_NODES.length) % GALAXY_NODES.length;
        state.selectedNodeIndex = clamped;
        const targetMesh = planetMeshes[clamped];
        const info = GALAXY_NODES[clamped];

        document.getElementById("node-index-badge").textContent = `NODO #${String(clamped + 1).padStart(2, "0")}`;
        document.getElementById("inspector-title").textContent = `${String(clamped + 1).padStart(2, "0")}. ${info.name}`;
        document.getElementById("inspector-desc").textContent = info.desc;
        document.getElementById("inspector-tags").innerHTML = `
          <span class="tag-chip">${info.category}</span>
          <span class="tag-chip">VIAJE 3D</span>
          <span class="tag-chip">BELENTANI</span>
        `;

        // Calcular posición mundial del planeta y volar hacia él
        const worldPos = new THREE.Vector3();
        targetMesh.getWorldPosition(worldPos);
        state.targetLookAt.copy(worldPos);
        state.targetCamPos.copy(worldPos).add(new THREE.Vector3(0, 1.35, 3.8));
        playHarmonicPulse(216 + clamped * 6);
      }

      /* ======================================================================
         F. INTERACCIÓN DE RATÓN, RAYCASTER 3D Y TERMINAL DE COMANDOS
         ====================================================================== */
      const raycaster = new THREE.Raycaster();
      const pointerNDC = new THREE.Vector2();
      const tooltip = document.getElementById("planet-tooltip");
      const cursorAura = document.getElementById("cursor-aura");

      window.addEventListener("pointermove", (e) => {
        cursorAura.style.left = e.clientX + "px";
        cursorAura.style.top = e.clientY + "px";

        pointerNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
        pointerNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
        state.mouse.copy(pointerNDC);

        raycaster.setFromCamera(pointerNDC, camera);
        const hits = raycaster.intersectObjects(planetMeshes, false);

        if (hits.length > 0) {
          const hit = hits[0].object;
          const { index, node } = hit.userData;
          tooltip.style.display = "block";
          tooltip.style.left = e.clientX + "px";
          tooltip.style.top = e.clientY + "px";
          tooltip.innerHTML = `<strong>#${String(index + 1).padStart(2, "0")} ${node.name}</strong><br/><span style="color:#e6b84c">${node.category}</span>`;
          document.body.style.cursor = "pointer";
        } else {
          tooltip.style.display = "none";
          document.body.style.cursor = "default";
        }
      });

      canvas.addEventListener("click", () => {
        raycaster.setFromCamera(pointerNDC, camera);
        const hits = raycaster.intersectObjects(planetMeshes, false);
        if (hits.length > 0) {
          selectGalaxyNode(hits[0].object.userData.index);
        }
      });

      // Comandos de terminal
      const terminalInput = document.getElementById("terminal-input");
      terminalInput.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        const raw = terminalInput.value.trim();
        if (!raw) return;
        terminalInput.value = "";
        executeCommand(raw);
      });

      function executeCommand(cmdRaw) {
        const parts = cmdRaw.toLowerCase().split(/\s+/);
        const cmd = parts[0];

        if (cmd === "/help") {
          terminalInput.placeholder = "Comandos: /shatter | /gold | /432hz | /galaxy | /core | /nodo [1-44] | /lore | /overload";
        } else if (cmd === "/shatter") {
          toggleShatter();
        } else if (cmd === "/gold") {
          state.goldMix = state.goldMix > 0.7 ? 0.25 : 0.95;
          document.getElementById("ctrl-gold").value = state.goldMix;
          document.getElementById("val-gold").textContent = state.goldMix.toFixed(2);
        } else if (cmd === "/432hz") {
          toggleDrone();
        } else if (cmd === "/galaxy") {
          setCameraPreset("galaxy");
        } else if (cmd === "/core") {
          setCameraPreset("core");
        } else if (cmd === "/nodo" && parts[1]) {
          const num = parseInt(parts[1], 10);
          if (!isNaN(num)) selectGalaxyNode(num - 1);
        } else if (cmd === "/lore") {
          document.getElementById("codex-modal").classList.add("open");
        } else if (cmd === "/overload") {
          state.morph = 2.8;
          state.goldMix = 0.92;
          state.shatterAmount = 2.1;
          state.speed = 2.6;
          toggleDrone(true);
        } else {
          // Buscar planeta por nombre parcial
          const matchIdx = GALAXY_NODES.findIndex((n) => n.name.toLowerCase().includes(cmd.replace("/", "")));
          if (matchIdx !== -1) {
            selectGalaxyNode(matchIdx);
          } else {
            terminalInput.placeholder = `Comando no reconocido: ${cmdRaw} (usa /help)`;
          }
        }
      }

      function setCameraPreset(preset) {
        document.querySelectorAll(".nav-pills .hud-btn[data-cam]").forEach((b) => {
          b.classList.toggle("active", b.dataset.cam === preset);
        });

        if (preset === "core") {
          state.targetCamPos.set(0, 2.4, 11.5);
          state.targetLookAt.set(0, 0, 0);
        } else if (preset === "galaxy") {
          state.targetCamPos.set(0, 16.5, 24.0);
          state.targetLookAt.set(0, 0, 0);
        } else if (preset === "throne") {
          state.targetCamPos.set(0, 28.0, 4.5);
          state.targetLookAt.set(0, 0, 0);
        }
      }

      function toggleShatter() {
        state.shatteredMode = !state.shatteredMode;
        state.shatterAmount = state.shatteredMode ? 1.85 : 0.25;
        document.getElementById("ctrl-shatter").value = state.shatterAmount;
        document.getElementById("val-shatter").textContent = state.shatterAmount.toFixed(2);
        document.getElementById("btn-shatter-toggle").textContent = state.shatteredMode
          ? "Reconstruir Espejos"
          : "Fracturar Espejos";
        playHarmonicPulse(state.shatteredMode ? 324 : 162);
      }

      /* ======================================================================
         G. LISTENERS DE CONTROLES & ATAJOS DE TECLADO
         ====================================================================== */
      document.getElementById("btn-enter-experience").addEventListener("click", () => {
        document.getElementById("boot-screen").classList.add("hidden");
        toggleDrone(true);
      });

      document.querySelectorAll(".nav-pills .hud-btn[data-cam]").forEach((btn) => {
        btn.addEventListener("click", () => setCameraPreset(btn.dataset.cam));
      });

      document.getElementById("btn-shatter-toggle").addEventListener("click", toggleShatter);
      document.getElementById("btn-audio-toggle").addEventListener("click", () => toggleDrone());

      document.getElementById("btn-open-codex").addEventListener("click", () => {
        document.getElementById("codex-modal").classList.add("open");
      });

      document.getElementById("btn-close-codex").addEventListener("click", () => {
        document.getElementById("codex-modal").classList.remove("open");
      });

      document.getElementById("btn-toggle-hud").addEventListener("click", () => {
        const mid = document.getElementById("hud-middle");
        const hidden = mid.style.visibility === "hidden";
        mid.style.visibility = hidden ? "visible" : "hidden";
        document.getElementById("btn-toggle-hud").textContent = hidden ? "Ocultar HUD [H]" : "Mostrar HUD [H]";
      });

      window.addEventListener("keydown", (e) => {
        if (document.activeElement === terminalInput) return;
        if (e.key.toLowerCase() === "h") {
          document.getElementById("btn-toggle-hud").click();
        } else if (e.key === "Escape") {
          document.getElementById("codex-modal").classList.remove("open");
        } else if (e.key === "ArrowRight") {
          selectGalaxyNode(state.selectedNodeIndex + 1);
        } else if (e.key === "ArrowLeft") {
          selectGalaxyNode(state.selectedNodeIndex - 1);
        }
      });

      // Sliders en vivo
      const bindSlider = (id, valId, key, suffix = "") => {
        const el = document.getElementById(id);
        const out = document.getElementById(valId);
        el.addEventListener("input", () => {
          state[key] = parseFloat(el.value);
          out.textContent = state[key].toFixed(2) + suffix;
        });
      };

      bindSlider("ctrl-morph", "val-morph", "morph");
      bindSlider("ctrl-gold", "val-gold", "goldMix");
      bindSlider("ctrl-shatter", "val-shatter", "shatterAmount");
      bindSlider("ctrl-speed", "val-speed", "speed", "x");
      bindSlider("ctrl-chroma", "val-chroma", "chroma");

      // Drag & Drop de audio local
      const dropzone = document.getElementById("audio-dropzone");
      const fileInput = document.getElementById("audio-file-input");
      fileInput.addEventListener("change", (e) => loadExternalAudioFile(e.target.files[0]));
      dropzone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropzone.style.background = "rgba(230, 184, 76, 0.22)";
      });
      dropzone.addEventListener("dragleave", () => {
        dropzone.style.background = "transparent";
      });
      dropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzone.style.background = "transparent";
        if (e.dataTransfer.files.length) loadExternalAudioFile(e.dataTransfer.files[0]);
      });

      window.addEventListener("resize", () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      /* ======================================================================
         H. VISUALIZADOR DE ESPECTRO HUD & BUCLE PRINCIPAL DE ANIMACIÓN
         ====================================================================== */
      const visCanvas = document.getElementById("audio-visualizer");
      const visCtx = visCanvas.getContext("2d");
      const currentLookAt = new THREE.Vector3(0, 0, 0);
      let lastFrameTime = performance.now();
      let frameCounter = 0;

      function updateAudioMetrics() {
        visCtx.clearRect(0, 0, visCanvas.width, visCanvas.height);

        if (analyser && freqData && state.audioActive) {
          analyser.getByteFrequencyData(freqData);

          let bassSum = 0;
          let midSum = 0;
          let highSum = 0;

          for (let i = 0; i < 12; i++) bassSum += freqData[i];
          for (let i = 12; i < 48; i++) midSum += freqData[i];
          for (let i = 48; i < 96; i++) highSum += freqData[i];

          state.bass = THREE.MathUtils.lerp(state.bass, bassSum / (12 * 255), 0.25);
          state.mid = THREE.MathUtils.lerp(state.mid, midSum / (36 * 255), 0.25);
          state.high = THREE.MathUtils.lerp(state.high, highSum / (48 * 255), 0.25);

          const bars = 48;
          const barW = visCanvas.width / bars;
          for (let i = 0; i < bars; i++) {
            const v = freqData[i] / 255;
            const h = Math.max(3, v * visCanvas.height * 0.9);
            const grad = visCtx.createLinearGradient(0, visCanvas.height, 0, 0);
            grad.addColorStop(0, "#ff002b");
            grad.addColorStop(1, "#e6b84c");
            visCtx.fillStyle = grad;
            visCtx.fillRect(i * barW + 1, visCanvas.height - h, barW - 2, h);
          }
        } else {
          // Onda latente en reposo
          state.bass = 0.08 + Math.sin(state.time * 2.2) * 0.04;
          state.mid = 0.05;
          state.high = 0.04;

          visCtx.strokeStyle = "rgba(255, 0, 43, 0.55)";
          visCtx.lineWidth = 1.5;
          visCtx.beginPath();
          for (let x = 0; x < visCanvas.width; x += 4) {
            const y = visCanvas.height * 0.5 + Math.sin(x * 0.04 + state.time * 4) * 6;
            if (x === 0) visCtx.moveTo(x, y);
            else visCtx.lineTo(x, y);
          }
          visCtx.stroke();
        }

        document.getElementById("stat-bass").textContent = state.bass.toFixed(2);
      }

      function animate(now) {
        requestAnimationFrame(animate);

        const dt = Math.min((now - lastFrameTime) / 1000, 0.05);
        lastFrameTime = now;
        state.time += dt * state.speed;

        // Cálculo de FPS cada 20 frames
        frameCounter++;
        if (frameCounter % 20 === 0) {
          document.getElementById("stat-fps").textContent = Math.round(1 / Math.max(dt, 0.001));
        }

        updateAudioMetrics();

        // Actualizar uniforms GLSL
        coreUniforms.uTime.value = state.time;
        coreUniforms.uMorph.value = state.morph;
        coreUniforms.uGoldMix.value = state.goldMix;
        coreUniforms.uBass.value = state.bass;
        coreUniforms.uMid.value = state.mid;
        coreUniforms.uHigh.value = state.high;
        coreUniforms.uCameraPos.value.copy(camera.position);

        skyMat.uniforms.uTime.value = state.time;
        skyMat.uniforms.uChroma.value = state.chroma;

        // Rotación del núcleo y anillos de oro
        coreMesh.rotation.y += dt * 0.25 * state.speed;
        ringsGroup.rotation.z += dt * 0.35 * state.speed;
        ringsGroup.rotation.y -= dt * 0.2 * state.speed;

        // Actualizar los 180 espejos fracturados
        for (let i = 0; i < SHARD_COUNT; i++) {
          const s = shardData[i];
          const r = s.baseRadius + state.shatterAmount * 2.4 + Math.sin(state.time * 1.5 + s.phase) * 0.35 + state.bass * 1.2;
          const angleOffset = state.time * 0.18 + s.phase;

          const x = r * Math.sin(s.phi) * Math.cos(s.theta + angleOffset);
          const y = r * Math.cos(s.phi) + Math.sin(state.time + s.phase) * 0.4;
          const z = r * Math.sin(s.phi) * Math.sin(s.theta + angleOffset);

          dummy.position.set(x, y, z);
          dummy.rotation.set(
            s.rotSpeed.x * state.time,
            s.rotSpeed.y * state.time,
            s.rotSpeed.z * state.time
          );
          const pulseScale = s.scale * (1 + state.bass * 0.45);
          dummy.scale.set(pulseScale, pulseScale, pulseScale);
          dummy.updateMatrix();
          shardInstanced.setMatrixAt(i, dummy.matrix);
        }
        shardInstanced.instanceMatrix.needsUpdate = true;

        // Rotación suave de la Galaxia de 44 Planetas
        galaxyGroup.rotation.y += dt * 0.08 * state.speed;
        planetMeshes.forEach((pm, idx) => {
          const isSelected = idx === state.selectedNodeIndex;
          const targetScale = isSelected ? 1.55 + Math.sin(state.time * 6) * 0.12 : 1.0 + state.bass * 0.25;
          pm.scale.lerp(new THREE.Vector3(targetScale, targetScale, targetScale), 0.12);
        });

        particleSystem.rotation.y -= dt * 0.03 * state.speed;

        // Interpolación suave de cámara + paralaje con el ratón
        const parallaxX = state.mouse.x * 1.6;
        const parallaxY = state.mouse.y * 1.1;
        const desiredCam = state.targetCamPos.clone().add(new THREE.Vector3(parallaxX, parallaxY, 0));

        camera.position.lerp(desiredCam, 0.055);
        currentLookAt.lerp(state.targetLookAt, 0.075);
        camera.lookAt(currentLookAt);

        renderer.render(scene, camera);
      }

      // Inicializar UI y arrancar loop
      renderTrackList();
      renderCodex();
      requestAnimationFrame(animate);
    })();
  </script>
