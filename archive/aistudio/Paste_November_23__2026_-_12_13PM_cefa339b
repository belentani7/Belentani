"use client";

import React, { useRef, useMemo } from "react";
import { Canvas, useFrame } from "@react-three/fiber";
import * as THREE from "three";

const vertexShader = /* glsl */ `
  varying vec2 vUv;
  void main() {
    vUv = uv;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;

const fragmentShader = /* glsl */ `
  uniform float uTime;
  uniform vec2 uMouse;
  varying vec2 vUv;

  // Ruido fluido orgánico
  float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
  }

  float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(
      mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),
      mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
      u.y
    );
  }

  void main() {
    vec2 uv = vUv;
    float distToMouse = distance(uv, uMouse);
    float ripple = exp(-distToMouse * 5.5) * sin(distToMouse * 28.0 - uTime * 4.0) * 0.04;

    vec2 distortedUv = uv + ripple;
    float n1 = noise(distortedUv * 4.5 + uTime * 0.25);
    float n2 = noise(distortedUv * 9.0 - uTime * 0.35 + n1);
    float liquid = smoothstep(0.35, 0.85, n2);

    vec3 obsidian = vec3(0.0, 0.0, 0.0);
    vec3 crimson = vec3(0.95, 0.02, 0.18);
    vec3 gold = vec3(0.96, 0.81, 0.38);

    // Mezcla entre negro obsidiana, carmesí viscoso y filamentos de oro líquido
    vec3 color = mix(obsidian, crimson, liquid * 0.75);
    float goldVein = smoothstep(0.78, 0.84, n2) * (1.0 - smoothstep(0.84, 0.90, n2));
    color += gold * goldVein * 1.4;

    gl_FragColor = vec4(color, 1.0);
  }
`;

function LiquidPlane() {
  const meshRef = useRef<THREE.Mesh>(null);
  const uniforms = useMemo(
    () => ({
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector2(0.5, 0.5) },
    }),
    []
  );

  useFrame((state) => {
    uniforms.uTime.value = state.clock.getElapsedTime();
    uniforms.uMouse.value.lerp(
      new THREE.Vector2(
        (state.pointer.x + 1) * 0.5,
        (state.pointer.y + 1) * 0.5
      ),
      0.08
    );
  });

  return (
    <mesh ref={meshRef} scale={[10, 10, 1]}>
      <planeGeometry args={[2, 2]} />
      <shaderMaterial
        vertexShader={vertexShader}
        fragmentShader={fragmentShader}
