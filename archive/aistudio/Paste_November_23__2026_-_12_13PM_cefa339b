  <script type="x-shader/x-vertex" id="liquidCoreVert">
    uniform float uTime;
    uniform float uMorph;
    uniform float uBass;
    uniform float uMid;

    varying vec3 vNormal;
    varying vec3 vWorldPos;
    varying vec2 vUv;
    varying float vDisplacement;

    // 3D Simplex Noise (Ashima / Gustavson)
    vec4 permute(vec4 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }
    vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

    float snoise(vec3 v) {
      const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
      const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);

      vec3 i  = floor(v + dot(v, C.yyy));
      vec3 x0 = v - i + dot(i, C.xxx);

      vec3 g = step(x0.yzx, x0.xyz);
      vec3 l = 1.0 - g;
      vec3 i1 = min(g.xyz, l.zxy);
      vec3 i2 = max(g.xyz, l.zxy);

      vec3 x1 = x0 - i1 + C.xxx;
      vec3 x2 = x0 - i2 + C.yyy;
      vec3 x3 = x0 - D.yyy;

      i = mod(i, 289.0);
      vec4 p = permute(permute(permute(
                i.z + vec4(0.0, i1.z, i2.z, 1.0))
              + i.y + vec4(0.0, i1.y, i2.y, 1.0))
              + i.x + vec4(0.0, i1.x, i2.x, 1.0));

      float n_ = 1.0 / 7.0;
      vec3 ns = n_ * D.wyz - D.xzx;

      vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
      vec4 x_ = floor(j * ns.z);
      vec4 y_ = floor(j - 7.0 * x_);

      vec4 x = x_ * ns.x + ns.yyyy;
      vec4 y = y_ * ns.x + ns.yyyy;
      vec4 h = 1.0 - abs(x) - abs(y);

      vec4 b0 = vec4(x.xy, y.xy);
      vec4 b1 = vec4(x.zw, y.zw);

      vec4 s0 = floor(b0) * 2.0 + 1.0;
      vec4 s1 = floor(b1) * 2.0 + 1.0;
      vec4 sh = -step(h, vec4(0.0));

      vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
      vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

      vec3 p0 = vec3(a0.xy, h.x);
      vec3 p1 = vec3(a0.zw, h.y);
      vec3 p2 = vec3(a1.xy, h.z);
      vec3 p3 = vec3(a1.zw, h.w);

      vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
      p0 *= norm.x;
      p1 *= norm.y;
      p2 *= norm.z;
      p3 *= norm.w;

      vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
      m = m * m;
      return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
    }

    void main() {
      vUv = uv;
      float t = uTime * 0.65;
      float n1 = snoise(position * 1.45 + vec3(t, -t * 0.7, t * 0.4));
      float n2 = snoise(position * 3.1 - vec3(t * 1.2));
      float disp = (n1 * 0.68 + n2 * 0.32) * (uMorph * 0.28 + uBass * 0.45);

      vDisplacement = disp;
      vec3 newPosition = position + normal * disp;

      vec4 worldPosition = modelMatrix * vec4(newPosition, 1.0);
      vWorldPos = worldPosition.xyz;
      vNormal = normalize(normalMatrix * normal);

      gl_Position = projectionMatrix * viewMatrix * worldPosition;
    }
  </script>

  <script type="x-shader/x-fragment" id="liquidCoreFrag">
    uniform float uTime;
    uniform float uGoldMix;
    uniform float uBass;
    uniform float uHigh;
    uniform vec3 uCameraPos;

    varying vec3 vNormal;
    varying vec3 vWorldPos;
    varying vec2 vUv;
    varying float vDisplacement;

    void main() {
      vec3 N = normalize(vNormal);
      vec3 V = normalize(uCameraPos - vWorldPos);
      float fresnel = pow(1.0 - max(dot(N, V), 0.0), 2.8);

      // Paleta Obsidiana + Carmesí Cuero Líquido + Oro Alquímico
      vec3 obsidian = vec3(0.02, 0.0, 0.01);
      vec3 crimsonDeep = vec3(0.45, 0.0, 0.07);
      vec3 crimsonNeon = vec3(1.0, 0.02, 0.18);
      vec3 liquidGold = vec3(0.95, 0.74, 0.26);

      float vein = smoothstep(0.06, 0.36, abs(vDisplacement) + sin(vWorldPos.y * 5.0 + uTime * 2.0) * 0.08);
      vec3 baseColor = mix(obsidian, crimsonDeep, smoothstep(-0.25, 0.25, vDisplacement));
      baseColor = mix(baseColor, crimsonNeon, vein * (0.65 + uBass * 0.5));

      // Vetas de oro líquido en crestas de desplazamiento
      float goldMask = smoothstep(0.18, 0.42, vDisplacement + fresnel * 0.35) * uGoldMix;
      baseColor = mix(baseColor, liquidGold, clamp(goldMask, 0.0, 0.92));

      // Reflejo especular tipo látex / vidrio húmedo
      vec3 lightDir = normalize(vec3(2.5, 4.0, 3.0));
      vec3 H = normalize(lightDir + V);
      float spec = pow(max(dot(N, H), 0.0), 48.0);

      vec3 rimGlow = mix(crimsonNeon, liquidGold, uGoldMix * 0.65) * fresnel * (1.35 + uHigh * 0.8);
      vec3 finalColor = baseColor + rimGlow + vec3(1.0, 0.9, 0.85) * spec * 0.65;

      gl_FragColor = vec4(finalColor, 0.96);
    }
  </script>

  <script type="x-shader/x-vertex" id="nebulaVert">
    varying vec3 vDir;
    void main() {
      vDir = position;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  </script>

  <script type="x-shader/x-fragment" id="nebulaFrag">
    uniform float uTime;
    uniform float uChroma;
    varying vec3 vDir;

    float hash(vec3 p) {
      p = fract(p * 0.3183099 + 0.1);
      p *= 17.0;
      return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
    }

    float noise(vec3 x) {
      vec3 i = floor(x);
      vec3 f = fract(x);
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(mix(hash(i + vec3(0,0,0)), hash(i + vec3(1,0,0)), f.x),
            mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
        mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x),
            mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y),
        f.z
      );
    }

    void main() {
      vec3 d = normalize(vDir);
      float n = noise(d * 3.2 + vec3(uTime * 0.03));
      float n2 = noise(d * 7.5 - vec3(uTime * 0.05));
      float nebula = smoothstep(0.42, 0.88, n * 0.65 + n2 * 0.35);

      vec3 col = vec3(0.0);
      col += vec3(0.22, 0.0, 0.04) * nebula;
      col += vec3(0.14, 0.09, 0.02) * pow(nebula, 3.0) * (0.5 + uChroma * 0.5);

      // Estrellas nítidas de fondo
      float star = pow(hash(floor(d * 420.0)), 28.0) * 1.8;
      col += vec3(1.0, 0.85, 0.88) * star;

      gl_FragColor = vec4(col, 1.0);
    }
  </script>

