# ──────────────────────────────────────────────
# Belentani Studio — Environment Variables Template
# Copy to .env and fill in the values.
# This file mirrors the variables actually read by server/_core/env.ts
# and the active code paths. Do NOT commit real secret values here.
# ──────────────────────────────────────────────

# ── Node ──────────────────────────────────────
# Runtime environment. "development" enables Vite dev middleware;
# "production" is used by `pnpm start`.
NODE_ENV=development

# Port the Express server listens on (defaults to 3000).
PORT=3000

# ── Platform / OAuth (Belentani platform) ─────
# Application id used as the OAuth client id / project id when talking
# to the platform OAuth server.
VITE_APP_ID=your-app-id

# OAuth / OpenID Connect provider base URL.
OAUTH_SERVER_URL=https://your-oidc-provider.example.com

# OpenID subject ("sub") claim of the platform owner. Users whose openId
# matches this value are granted the "admin" role.
OWNER_OPEN_ID=your-openid-sub-claim

# ── Auth / Sessions ──────────────────────────
# SECRET: used to sign JWT/authentication cookies. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# ── Database (MySQL via Drizzle ORM) ─────────
# SECRET: full connection string. This is the ONLY database variable the
# code reads (used by server/db.ts and drizzle.config.ts).
DATABASE_URL=mysql://user:password@localhost:3306/belentani

# ── Forge (built-in AI/LLM + storage backend) ─
# SECRET: base URL and API key for the Manus "Forge" backend that powers
# LLM calls, image generation, and S3 presigned storage.
BUILT_IN_FORGE_API_URL=https://your-forge.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ── Tests (optional) ─────────────────────────
# Base URL used only by the integration test. Defaults to http://127.0.0.1:3000
# when unset, so this is normally not required.
# INTEGRATION_BASE_URL=http://127.0.0.1:3000
