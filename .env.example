# ──────────────────────────────────────────────
# NOIACORE LAB — Environment Variables Template
# Copy to .env and fill in the values.
# ──────────────────────────────────────────────

# ── Node ──────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MySQL via Drizzle ORM) ─────────
# Full connection string — takes precedence if set
DATABASE_URL=mysql://user:password@localhost:3306/noiacore

# Or individual fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=noiacore

# ── Auth / Sessions ──────────────────────────
# Secret used to sign JWT cookies (any long random string)
JWT_SECRET=change-me-to-a-random-secret

# ── OAuth / OpenID Connect ───────────────────
OAUTH_SERVER_URL=https://your-oidc-provider.example.com
OWNER_OPEN_ID=your-openid-sub-claim

# ── LLM / AI Agent ───────────────────────────
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1

# ── S3 / Object Storage ──────────────────────
S3_BUCKET=noiacore-assets
S3_REGION=eu-west-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ── Platform integration ─────────────────────
VITE_APP_ID=my-app-id
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
